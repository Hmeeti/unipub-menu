# ─────────────────────────────────────────────────────────────────────────────
# UNIPUB menu — environment. Copy to .env (local) or deploy/.env (server).
# Secrets come ONLY from the environment. Never commit real values.
# Locally everything is optional: without DATABASE_URL/REDIS_URL the app uses an
# embedded PGlite database (.data/pglite) and in-memory limits.
# ─────────────────────────────────────────────────────────────────────────────

# local | staging | production | test
APP_ENV=local
# Public origin of the menu (used for QR links, CORS, sitemap, OG)
APP_URL=http://localhost:3000
# Extra allowed origins for API CORS, comma-separated exact origins (e.g. the staging domain)
ALLOWED_ORIGINS=
LOG_LEVEL=info
# Stable id for version-skew protection (CI sets the git SHA)
DEPLOYMENT_VERSION=

# ── Secrets (generate: openssl rand -base64 48) ──────────────────────────────
# Signs guest sessions, CSRF tokens; ≥32 chars
APP_SECRET=
# Signs QR table tokens. Rotating it invalidates ALL printed QR codes.
TABLE_TOKEN_SECRET=
# AES-256-GCM key for short-lived PII in the outbox (booking name/phone) and TOTP secrets.
# 32 bytes base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# ── Database / Redis ─────────────────────────────────────────────────────────
# Location is configurable: point to a server in Kazakhstan if local data law requires it.
DATABASE_URL=
DATABASE_POOL_MAX=10
REDIS_URL=
# Local fallback database directory (used only when DATABASE_URL is empty)
PGLITE_DIR=.data/pglite
# Run migrations on app start (staging convenience; production uses the `migrate` service)
AUTO_MIGRATE=false
# docker compose only:
POSTGRES_PASSWORD=
SITE_DOMAIN=menu.example.kz
ACME_EMAIL=admin@example.kz
APP_IMAGE=ghcr.io/hmeeti/unipub-app:latest

# ── Telegram (grammY, webhook) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Group chat id where orders go (e.g. -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Leave empty in production; tests point it to a mock server
TELEGRAM_API_ROOT=

# inline: the app process also runs the outbox worker (local/staging).
# external: a separate `worker` container does it (production).
WORKER_MODE=inline

# ── Network / Cloudflare ─────────────────────────────────────────────────────
# Number of trusted reverse proxies in front of Node (Caddy = 1; compose sets it).
# Caddy accepts CF-Connecting-IP only from Cloudflare ranges and forwards it as X-Real-IP.
TRUST_PROXY_HOPS=0
# x-real-ip (Caddy) | x-forwarded-for (platforms that only append to it, e.g. Render)
CLIENT_IP_HEADER=x-real-ip

# ── Object storage for photos (Cloudflare R2 / MinIO) ────────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN base for the bucket, e.g. https://img.menu.example.kz
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ── Machine translation for non-native languages (server-side only) ──────────
# none | deepl | google
TRANSLATE_PROVIDER=none
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com
GOOGLE_TRANSLATE_API_KEY=

# ── Cloudflare Turnstile (optional, only shown on suspicious activity) ───────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cookie-less analytics (off by default) ───────────────────────────────────
# none | goatcounter | plausible
ANALYTICS_PROVIDER=none
GOATCOUNTER_ENDPOINT=
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# ── Feature kill switches (on|off); fine-grained toggles live in the admin ───
FEATURE_BOOKING=on
FEATURE_SONGS=on
FEATURE_PROMOS=on

# ── Backups (deploy/backup) ──────────────────────────────────────────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_RETENTION_DAYS=14
BACKUP_HEALTHCHECK_URL=

# ── First owner account (used once by `npm run db:seed` / create-admin) ──────
# On server start it is also created when no admin exists yet (hosts without a shell).
ADMIN_LOGIN=
ADMIN_PASSWORD=

# ── Hosts without a shell (Render Free), see render.yaml ─────────────────────
# Import the legacy menu on start when the database is empty, also in production
SEED_IF_EMPTY=false
# Register the Telegram webhook at APP_URL on start (needs https and TELEGRAM_WEBHOOK_SECRET)
TELEGRAM_AUTO_WEBHOOK=false

# ── Tests only. NEVER enable in production. ──────────────────────────────────
E2E_TEST_HOOKS=false
