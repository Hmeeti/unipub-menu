{
	email {$ACME_EMAIL}
	servers {
		# Cloudflare sits in front; only its ranges are trusted for the client IP.
		# The app additionally validates CF-Connecting-IP against these ranges (TRUST_CLOUDFLARE=true).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Static assets are content-hashed and immutable.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:3000 {
		# SSE: flush immediately, never buffer.
		flush_interval -1
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format json
	}
}

# Optional extra sites (e.g. staging): copy caddy-extra/staging.caddy.example → staging.caddy
import /etc/caddy/extra/*.caddy
